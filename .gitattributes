* text=auto eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.pdf binary

# Scientific owners and records retain exact bytes after root consolidation.
# Authors write new text as UTF-8 LF; Git must not convert migrated evidence.
src/** -text
scripts/** -text
tests/** -text
docs/** -text
results/** -text

# Paper sources, figure manifests and rendered assets are authenticated as bytes.
paper/** -text

# Archived scientific contexts preserve their original byte identities.
archive/** -text
paper/archive/** -text
